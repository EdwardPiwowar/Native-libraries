<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>EPBotFFI</RootNamespace>
    <AssemblyName>EPBotWasm</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>wasi-wasm</RuntimeIdentifier>

    <!-- WASM: bez NativeAOT, bez trimmingu (VB.NET runtime niekompatybilny z trimmerem) -->
    <PublishTrimmed>false</PublishTrimmed>
    <SelfContained>true</SelfContained>

    <Version>0.0.0.8741</Version>
    <Authors>Edward Piwowar</Authors>
    <Copyright>Edward Piwowar</Copyright>
    <AssemblyVersion>0.0.0.8741</AssemblyVersion>
    <FileVersion>0.0.0.8741</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="EPBotNET">
      <HintPath>dll/EPBotNET.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
