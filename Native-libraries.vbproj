<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>EPBotFFI</RootNamespace>
    <AssemblyName>EPBot</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- NativeAOT -->
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>

    <TrimmerRootDescriptor>TrimmerRoots.xml</TrimmerRootDescriptor>

    <Version>0.0.0.8741</Version>
    <Authors>Edward Piwowar</Authors>
    <Copyright>Edward Piwowar</Copyright>
    <AssemblyVersion>0.0.0.8741</AssemblyVersion>
    <FileVersion>0.0.0.8741</FileVersion>
  </PropertyGroup>

  <!-- Referencja do skompilowanego EPBotNET.dll -->
  <ItemGroup>
    <Reference Include="EPBotNET">
      <HintPath>dll/EPBotNET.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
