<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>EPBotFFI</RootNamespace>
    <!-- Windows: EPBot.dll, Linux/macOS: libEPBot.so / libEPBot.dylib -->
    <AssemblyName Condition="$(DefineConstants.Contains('WINDOWS'))">EPBot</AssemblyName>
    <AssemblyName Condition="!$(DefineConstants.Contains('WINDOWS'))">libEPBot</AssemblyName>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- NativeAOT -->
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>

    <TrimmerRootDescriptor>TrimmerRoots.xml</TrimmerRootDescriptor>
    <!-- rd.xml: Runtime Directives dla NativeAOT — umożliwia refleksję w runtime -->
    <RdXmlFile>rd.xml</RdXmlFile>

    <Version>0.0.0.8741</Version>
    <Authors>Edward Piwowar</Authors>
    <Copyright>Edward Piwowar</Copyright>
    <AssemblyVersion>0.0.0.8741</AssemblyVersion>
    <FileVersion>0.0.0.8741</FileVersion>
  </PropertyGroup>

  <!-- Stack trace data — wyłączone dla natywnych, niedostępne dla WASM -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != 'wasi-wasm'">
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
  </PropertyGroup>

  <!-- TargetFramework: WASM wymaga net10.0 bez wariantu -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'wasi-wasm'">
    <TargetFramework>net10.0</TargetFramework>
    <!-- WASM nie obsługuje wątków ani dynamicznego IL -->
    <WasmNativeStrip>true</WasmNativeStrip>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != 'wasi-wasm'">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- Referencja do skompilowanego EPBotNET.dll -->
  <ItemGroup>
    <Reference Include="EPBotNET">
      <HintPath>dll/EPBotNET.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>